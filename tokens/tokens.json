{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "name": "Cert Master / 考证匠 — Design Tokens",
    "version": "0.1.0",
    "owner": "JR Academy",
    "tagline": "你的 AI 考证搭子，学习更高效",
    "mascot": "penguin",
    "grid": "4pt",
    "primaryFont": "PingFang SC",
    "source": "assets/mascot/spec-sheet.png (ChatGPT 2026-05-11)"
  },
  "color": {
    "brand": {
      "yellow":  { "$value": "#FFC52A", "$type": "color", "$description": "考证黄 — primary, CTA, energy" },
      "orange":  { "$value": "#FF7A45", "$type": "color", "$description": "活力橙 — secondary highlight, streak" },
      "mint":    { "$value": "#2ECCB2", "$type": "color", "$description": "薄荷绿 — success, completion" },
      "sky":     { "$value": "#5AA7FF", "$type": "color", "$description": "天空蓝 — info, AI" },
      "taro":    { "$value": "#A78BFA", "$type": "color", "$description": "香芋紫 — premium, advanced" }
    },
    "neutral": {
      "ink":      { "$value": "#111827", "$type": "color", "$description": "深黑 — H1/正文最深" },
      "graphite": { "$value": "#374151", "$type": "color", "$description": "深灰 — 次正文" },
      "slate":    { "$value": "#6B7280", "$type": "color", "$description": "中灰 — caption" },
      "mist":     { "$value": "#9CA3AF", "$type": "color", "$description": "浅灰 — placeholder/disabled label" },
      "fog":      { "$value": "#E5E7EB", "$type": "color", "$description": "更浅灰 — border/divider" },
      "canvas":   { "$value": "#F5F6F8", "$type": "color", "$description": "背景灰 — 页面默认 bg（不要纯白）" },
      "white":    { "$value": "#FFFFFF", "$type": "color", "$description": "白色 — card surface" }
    },
    "wash": {
      "yellow": { "$value": "#FFF7DA", "$type": "color" },
      "orange": { "$value": "#FFE5D9", "$type": "color" },
      "mint":   { "$value": "#DAF5EF", "$type": "color" },
      "sky":    { "$value": "#DCE9FF", "$type": "color" },
      "taro":   { "$value": "#ECE4FE", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "{color.brand.mint}",   "$type": "color" },
      "warning": { "$value": "{color.brand.yellow}", "$type": "color" },
      "danger":  { "$value": "{color.brand.orange}", "$type": "color" },
      "info":    { "$value": "{color.brand.sky}",    "$type": "color" }
    }
  },
  "radius": {
    "xs":   { "$value": "4px",   "$type": "dimension" },
    "sm":   { "$value": "8px",   "$type": "dimension" },
    "md":   { "$value": "12px",  "$type": "dimension" },
    "lg":   { "$value": "16px",  "$type": "dimension" },
    "xl":   { "$value": "24px",  "$type": "dimension" },
    "full": { "$value": "9999px","$type": "dimension" }
  },
  "spacing": {
    "1": { "$value": "4px",  "$type": "dimension" },
    "2": { "$value": "8px",  "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12":{ "$value": "48px", "$type": "dimension" },
    "16":{ "$value": "64px", "$type": "dimension" }
  },
  "shadow": {
    "sm":     { "$value": "0px 1px 2px rgba(0,0,0,0.04)",  "$type": "shadow", "$description": "小阴影 — 静态 chip / divider 替代" },
    "md":     { "$value": "0px 4px 12px rgba(0,0,0,0.08)", "$type": "shadow", "$description": "中阴影 — 卡片默认" },
    "lg":     { "$value": "0px 10px 24px rgba(0,0,0,0.10)","$type": "shadow", "$description": "大阴影 — modal / floating" },
    "yellow": { "$value": "0 8px 20px rgba(255,197,42,0.35)",  "$type": "shadow", "$description": "黄色按钮发光 — primary CTA" },
    "mint":   { "$value": "0 8px 20px rgba(46,204,178,0.30)",  "$type": "shadow", "$description": "通过/完成发光" },
    "sky":    { "$value": "0 8px 20px rgba(90,167,255,0.30)",  "$type": "shadow", "$description": "AI 提示发光" }
  },
  "font": {
    "family": {
      "sans": {
        "$value": "'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
        "$type": "fontFamily",
        "$description": "中英主字体 — 简洁/现代/易读"
      },
      "mono": {
        "$value": "'JetBrains Mono', 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace",
        "$type": "fontFamily",
        "$description": "等宽 — 题号/分数/计时器/答题代码"
      }
    },
    "size": {
      "h1":      { "$value": "34px", "$type": "dimension" },
      "h2":      { "$value": "24px", "$type": "dimension" },
      "h3":      { "$value": "20px", "$type": "dimension" },
      "body":    { "$value": "16px", "$type": "dimension" },
      "caption": { "$value": "12px", "$type": "dimension" }
    },
    "weight": {
      "regular":  { "$value": "400", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold":     { "$value": "700", "$type": "fontWeight" }
    },
    "tracking": {
      "tight":  { "$value": "-0.01em", "$type": "dimension", "$description": "H1 -1%" },
      "snug":   { "$value": "-0.005em","$type": "dimension", "$description": "H2 -0.5%" },
      "normal": { "$value": "0",       "$type": "dimension" }
    },
    "lineHeight": {
      "heading": { "$value": "1.25", "$type": "number" },
      "body":    { "$value": "1.6",  "$type": "number" }
    }
  },
  "motion": {
    "duration": {
      "fast":   { "$value": "120ms", "$type": "duration" },
      "base":   { "$value": "200ms", "$type": "duration" },
      "slow":   { "$value": "320ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)",  "$type": "cubicBezier" },
      "spring":   { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)","$type": "cubicBezier", "$description": "checkbox 打勾 / 通过弹跳" }
    }
  },
  "mascot": {
    "states": [
      "happy",
      "studying",
      "thinking",
      "ai-analyzing",
      "sprint",
      "anxious",
      "passed",
      "champion"
    ],
    "_note": "8 个标准态。禁止自创新表情，新场景必须 map 到已有态。"
  },
  "featureColorMap": {
    "ai-assistant":  { "$value": "{color.brand.yellow}",  "$type": "color", "$description": "AI 助手" },
    "smart-fast":    { "$value": "{color.brand.mint}",    "$type": "color", "$description": "智能高效" },
    "growth":        { "$value": "{color.brand.orange}",  "$type": "color", "$description": "陪伴成长" },
    "certified":     { "$value": "{color.brand.sky}",     "$type": "color", "$description": "通过有证" },
    "premium":       { "$value": "{color.brand.taro}",    "$type": "color", "$description": "进阶/高级" }
  }
}
